<body class="bg-surface font-body-md text-on-surface antialiased">
    <header class="fixed top-0 left-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-20 w-full px-margin mx-auto flex items-center justify-between gap-space-lg">
            <div class="flex items-center gap-space-lg">
                <div class="flex items-center gap-space-sm">
                    <img alt="EcoFootprint Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1Wqhxaz9ZCHVn9qvqTPZLtdWW1jDqjRBs1QLdb3HtI1FVEXHDdME_ZnKNcbL5aEcmpLmjgKTVEI3kc2rcENMTRXqp5VFdo1IRcc-hexe9IlQ7gmVz8WNSCp4pLxWXd5ts4CeuOkO33QT31aGoY9UKQWVSzursGIfgVVor1C6gfETMiWSw5nxNO0WlS8XgnLgl0-RPh4IxE9J0p2ZBWmpcFSc_Qo2p3ZlT3dTndj4RoLqiNvwv3H1I2CAA" />
                    <span class="font-headline-sm text-headline-sm text-primary tracking-tight font-bold">EcoFootprint</span>
                </div>
                <div class="h-6 w-[1px] bg-outline-variant/40 hidden xl:block"></div>
                <nav class="hidden lg:flex items-center gap-space-xs" data-active-classes="bg-surface-container-high text-primary font-bold rounded-lg">
                    <a aria-current="page" class="px-space-md py-space-sm transition-colors bg-surface-container-high text-primary font-bold rounded-lg" data-path="calculadora" href="#">Calculadora</a>
                    <a class="px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low rounded-lg transition-colors" data-path="desglose-por-sectores" href="#">Desglose por Sectores</a>
                    <a class="px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low rounded-lg transition-colors" data-path="planes-de-compensacion" href="#">Planes de Compensación</a>
                    <a class="px-space-md py-space-sm font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low rounded-lg transition-colors" data-path="metodologia-y-datos" href="#">Metodología &amp; Datos</a>
                </nav>
            </div>
            <div class="flex items-center gap-space-md">
                <div class="hidden sm:flex items-center p-space-xs bg-surface-container-low rounded-full">
                    <button class="px-space-sm py-1 rounded-full font-label-sm text-label-sm bg-surface-container-lowest text-primary shadow-[0_1px_4px_rgba(0,0,0,0.06)] font-semibold" type="button">Kg CO2e</button>
                    <button class="px-space-sm py-1 rounded-full font-label-sm text-label-sm text-on-surface-variant hover:text-on-surface font-medium transition-colors" type="button">Ton CO2e</button>
                </div>
                <button class="hidden md:inline-flex items-center gap-space-xs px-space-md py-2.5 bg-primary-container text-on-primary font-label-md text-label-md rounded-lg hover:bg-primary transition-all shadow-[0_2px_8px_rgba(13,92,58,0.2)]" type="button">
                    <span class="material-symbols-outlined text-[18px]">bookmark</span>
                    <span>Guardar Reporte</span>
                </button>
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                </div>
            </div>
        </div>
    </header>

    <main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]">
        <div class="flex flex-col w-full">
            <!-- Interactive Calculator Canvas -->
            <div class="w-full px-margin-mobile md:px-margin-tablet xl:px-margin py-space-xl max-w-[1480px] mx-auto">
                <!-- Top Context & Interactive Preset Ribbon -->
                <section class="mb-space-xl">
                    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg bg-surface-container-low p-space-lg md:p-space-xl rounded-xl shadow-sm">
                        <div class="max-w-2xl space-y-space-xs">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container text-primary font-label-sm text-label-sm uppercase tracking-wider">
                                <span class="material-symbols-outlined text-[15px]">vital_signs</span>
                                <span>Algoritmo IPCC AR6 • Factores 2024</span>
                            </div>
                            <h1 class="font-headline-xl text-headline-xl text-primary tracking-tight font-bold">
                                Calculadora de Emisiones de CO<sub class="text-sm">2</sub>e
                            </h1>
                            <p class="font-body-md text-body-md text-on-surface-variant">
                                Estima tu impacto climático individual por hábitos de movilidad, eficiencia residencial, patrón nutricional y ritmo de consumo con factores normalizados para España y la Unión Europea.
                            </p>
                        </div>
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md">
                            <!-- Time Horizon Selector -->
                            <div class="flex items-center bg-surface-container p-1 rounded-xl shadow-inner">
                                <button class="px-space-md py-2 rounded-lg font-label-md text-label-md bg-surface-container-lowest text-primary shadow-sm font-semibold transition-all" id="btn-period-year" onclick="setPeriod('annual')">
                                    Anual (Recomendado)
                                </button>
                                <button class="px-space-md py-2 rounded-lg font-label-md text-label-md text-on-surface-variant hover:text-on-surface font-medium transition-all" id="btn-period-month" onclick="setPeriod('monthly')">
                                    Mensual
                                </button>
                            </div>
                            <!-- Quick Presets -->
                            <div class="flex items-center gap-1.5 bg-surface-container-highest/60 p-1.5 rounded-xl">
                                <span class="font-label-sm text-label-sm text-on-surface-variant px-2 hidden xl:inline">Perfiles:</span>
                                <button class="px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-container-lowest text-on-surface-variant hover:text-primary text-label-sm font-label-sm transition-colors flex items-center gap-1" onclick="applyPreset('urban')">
                                    <span class="material-symbols-outlined text-[16px]">apartment</span>
                                    <span>Urbano</span>
                                </button>
                                <button class="px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-container-lowest text-on-surface-variant hover:text-primary text-label-sm font-label-sm transition-colors flex items-center gap-1" onclick="applyPreset('eco')">
                                    <span class="material-symbols-outlined text-[16px]">compost</span>
                                    <span>Bajo Impacto</span>
                                </button>
                                <button class="px-2.5 py-1.5 rounded-lg text-left hover:bg-surface-container-lowest text-on-surface-variant hover:text-primary text-label-sm font-label-sm transition-colors flex items-center gap-1" onclick="applyPreset('family')">
                                    <span class="material-symbols-outlined text-[16px]">cottage</span>
                                    <span>Familiar</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Dual Column Workspace (Split Layout 7 / 5) -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
                    <!-- LEFT COLUMN: Interactive Questionnaire Form Sections (col-span-7) -->
                    <div class="lg:col-span-7 space-y-space-lg">
                        <!-- Section A: Transporte y Movilidad -->
                        <article class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm transition-all duration-300 hover:shadow-md">
                            <div class="flex items-center justify-between pb-space-md">
                                <div class="flex items-center gap-space-sm">
                                    <div class="w-10 h-10 rounded-xl bg-primary-container/10 flex items-center justify-center text-primary-container">
                                        <span class="material-symbols-outlined text-[24px]">directions_car</span>
                                    </div>
                                    <div>
                                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Transporte &amp; Movilidad</h2>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant">Desplazamientos terrestres y tráfico aéreo recurrente</p>
                                    </div>
                                </div>
                                <span class="font-label-md text-label-md px-2.5 py-1 rounded-full bg-surface-container-high text-primary font-semibold" id="badge-transport-tons">
                                    2.10 t CO2e
                                </span>
                            </div>
                            <div class="space-y-space-lg pt-space-xs">
                                <!-- Combustible vehículo -->
                                <div>
                                    <label class="block font-title-md text-title-md text-on-surface mb-2">Vehículo personal habitual</label>
                                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="car-fuel-selector">
                                        <button class="fuel-btn active-fuel p-3 rounded-lg text-center bg-primary-container text-on-primary transition-all shadow-sm" onclick="selectFuel('gasolina')" type="button">
                                            <span class="material-symbols-outlined block mx-auto text-[20px] mb-1">local_gas_station</span>
                                            <span class="font-label-sm text-label-sm block">Gasolina</span>
                                        </button>
                                        <button class="fuel-btn p-3 rounded-lg text-center bg-surface-container-low hover:bg-surface-container text-on-surface transition-all" onclick="selectFuel('diesel')" type="button">
                                            <span class="material-symbols-outlined block mx-auto text-[20px] mb-1">oil_barrel</span>
                                            <span class="font-label-sm text-label-sm block">Diésel</span>
                                        </button>
                                        <button class="fuel-btn p-3 rounded-lg text-center bg-surface-container-low hover:bg-surface-container text-on-surface transition-all" onclick="selectFuel('hibrido')" type="button">
                                            <span class="material-symbols-outlined block mx-auto text-[20px] mb-1">electric_meter</span>
                                            <span class="font-label-sm text-label-sm block">Híbrido</span>
                                        </button>
                                        <button class="fuel-btn p-3 rounded-lg text-center bg-surface-container-low hover:bg-surface-container text-on-surface transition-all" onclick="selectFuel('electrico')" type="button">
                                            <span class="material-symbols-outlined block mx-auto text-[20px] mb-1">electric_bolt</span>
                                            <span class="font-label-sm text-label-sm block">Eléctrico</span>
                                        </button>
                                        <button class="fuel-btn p-3 rounded-lg text-center bg-surface-container-low hover:bg-surface-container text-on-surface transition-all col-span-2 sm:col-span-1" onclick="selectFuel('ninguno')" type="button">
                                            <span class="material-symbols-outlined block mx-auto text-[20px] mb-1">pedal_bike</span>
                                            <span class="font-label-sm text-label-sm block">Sin Coche</span>
                                        </button>
                                    </div>
                                </div>
                                <!-- Kilómetros Semanales Slider -->
                                <div id="km-slider-container">
                                    <div class="flex justify-between items-center mb-1.5">
                                        <span class="font-title-md text-title-md text-on-surface">Distancia en coche particular</span>
                                        <span class="font-headline-sm text-headline-sm text-primary font-bold" id="val-km-car">190 km<span class="text-body-sm font-normal text-on-surface-variant">/semana</span></span>
                                    </div>
                                    <input class="w-full h-2 bg-surface-container-high rounded-lg appearance-none cursor-pointer accent-primary-container" id="input-km-car" max="800" min="0" oninput="updateCalculations()" step="10" type="range" value="190" />
                                    <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1">
                                        <span>0 km</span>
                                        <span>200 km</span>
                                        <span>400 km</span>
                                        <span>600 km</span>
                                        <span>800+ km</span>
                                    </div>
                                </div>
                                <!-- Transporte Público -->
                                <div>
                                    <div class="flex justify-between items-center mb-1.5">
                                        <span class="font-title-md text-title-md text-on-surface">Horas en transporte colectivo (tren, metro, bus)</span>
                                        <span class="font-headline-sm text-headline-sm text-secondary font-bold" id="val-transit-hours">6 h<span class="text-body-sm font-normal text-on-surface-variant">/semana</span></span>
                                    </div>
                                    <input class="w-full h-2 bg-surface-container-high rounded-lg appearance-none cursor-pointer accent-secondary" id="input-transit-hours" max="30" min="0" oninput="updateCalculations()" step="1" type="range" value="6" />
                                    <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1">
                                        <span>0 h</span>
                                        <span>10 h</span>
                                        <span>20 h</span>
                                        <span>30 h/semana</span>
                                    </div>
                                </div>
                                <!-- Vuelos Anuales Steppers -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-space-xs">
                                    <div class="bg-surface-container-low p-space-md rounded-xl flex items-center justify-between">
                                        <div>
                                            <div class="font-title-md text-title-md text-on-surface">Vuelos de corto radio</div>
                                            <div class="font-body-sm text-body-sm text-on-surface-variant">&lt; 3 horas (Ej. península / Europa)</div>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <button class="w-8 h-8 rounded-lg bg-surface-container-highest hover:bg-surface-container text-on-surface font-bold flex items-center justify-center transition-colors" onclick="adjustFlight('short', -1)" type="button">
                                                <span class="material-symbols-outlined text-[18px]">remove</span>
                                            </button>
                                            <span class="font-headline-sm text-headline-sm font-bold text-on-surface w-7 text-center" id="val-flights-short">2</span>
                                            <button class="w-8 h-8 rounded-lg bg-surface-container-highest hover:bg-surface-container text-on-surface font-bold flex items-center justify-center transition-colors" onclick="adjustFlight('short', 1)" type="button">
                                                <span class="material-symbols-outlined text-[18px]">add</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="bg-surface-container-low p-space-md rounded-xl flex items-center justify-between">
                                        <div>
                                            <div class="font-title-md text-title-md text-on-surface">Vuelos transoceánicos</div>
                                            <div class="font-body-sm text-body-sm text-on-surface-variant">&gt; 6 horas (América, Asia, etc.)</div>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <button class="w-8 h-8 rounded-lg bg-surface-container-highest hover:bg-surface-container text-on-surface font-bold flex items-center justify-center transition-colors" onclick="adjustFlight('long', -1)" type="button">
                                                <span class="material-symbols-outlined text-[18px]">remove</span>
                                            </button>
                                            <span class="font-headline-sm text-headline-sm font-bold text-on-surface w-7 text-center" id="val-flights-long">1</span>
                                            <button class="w-8 h-8 rounded-lg bg-surface-container-highest hover:bg-surface-container text-on-surface font-bold flex items-center justify-center transition-colors" onclick="adjustFlight('long', 1)" type="button">
                                                <span class="material-symbols-outlined text-[18px]">add</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <!-- Section B: Energía & Vivienda -->
                        <article class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm transition-all duration-300 hover:shadow-md">
                            <div class="flex items-center justify-between pb-space-md">
                                <div class="flex items-center gap-space-sm">
                                    <div class="w-10 h-10 rounded-xl bg-secondary/10 flex items-center justify-center text-secondary">
                                        <span class="material-symbols-outlined text-[24px]">bolt</span>
                                    </div>
                                    <div>
                                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Energía &amp; Hogar</h2>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant">Electricidad, climatización y personas convivientes</p>
                                    </div>
                                </div>
                                <span class="font-label-md text-label-md px-2.5 py-1 rounded-full bg-surface-container-high text-primary font-semibold" id="badge-energy-tons">
                                    1.45 t CO2e
                                </span>
                            </div>
                            <div class="space-y-space-lg pt-space-xs">
                                <!-- Habitantes del domicilio -->
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm bg-surface-container-low p-space-md rounded-xl">
                                    <div>
                                        <div class="font-title-md text-title-md text-on-surface">Personas en el hogar</div>
                                        <div class="font-body-sm text-body-sm text-on-surface-variant">Las emisiones comunes se dividen equitativamente</div>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <button class="household-btn w-9 h-9 rounded-lg bg-surface-container-lowest text-on-surface font-label-md text-label-md hover:bg-surface-container-high" onclick="setHousehold(1)" type="button">1</button>
